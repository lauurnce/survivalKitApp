.superpowers/
# Machine-local permission allowlist — not shared config.
.claude/settings.local.json

# content source PDFs (large files)
/content-source/
/scripts/output/

# Local-only docs
docs/NEXT_STEPS.md

# Git worktrees
.worktrees/

# Local preview stores (PROFILE_STORE=file)
.dev/

# Local data exports — these contain personal data (names, emails) pulled
# from the live database. Never commit them; delete once you're done.
waitlist-backup-*.json

# Private retrospective — contains revenue/conversion numbers excluded from
# public disclosure (see STORY.md disclosure rules).
docs/POST-MORTEM.md

# Hosting status reports moved under docs/reports/ops/hosting/ — covered by the
# docs/reports/ rule below. Entry kept so an old working copy stays ignored.
docs/vercel-status/
.env*

# Department agent reports — conversion, revenue, and security findings. A
# security report in a public repo is a published attack surface. Same
# disclosure rules as the post-mortem.
docs/reports/

# Supabase CLI local link state — pooler-url carries a database connection
# string with credentials. Never commit.
supabase/.temp/
